{
    "name": "glottis",
    "version": "0.1.2",
    "description": "Give a page a public client API: serve() functions from a frame or window, connect() from anywhere, with live function references across the boundary.",
    "keywords": [
        "iframe",
        "popup",
        "postmessage",
        "rpc",
        "cross-domain",
        "api",
        "post-robot",
        "mcp",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/glottis#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/glottis/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/glottis.git"
    },
    "license": "MIT",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run build && npm run test:unit",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@vitest/coverage-istanbul": "^5.0.5",
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0",
        "zod": "^4.6.7"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "dependencies": {
        "belter": "^3.0.1",
        "cross-domain-utils": "^4.0.2",
        "post-robot": "^12.2.1",
        "sandestin": "^0.5.0",
        "zalgo-promise": "^3.0.1"
    }
}
